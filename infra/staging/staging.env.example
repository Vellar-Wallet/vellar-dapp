# Railway STAGING environment variables for the combined backend
# (@vellar/all-in-one, root Dockerfile). Paste into the staging environment's
# Raw Editor. Every value here is TESTNET. See docs/runbooks/staging-and-promotion.md.
#
# The service REFUSES TO BOOT (exit 1, naming each problem) if DEPLOY_ENV=staging
# and any of: STELLAR_NETWORK is not testnet, the passphrase or RPC look like
# mainnet, DATABASE_URL is missing, ALLOW_INMEMORY or ALLOW_SINGLE_KEY_ATTESTOR is
# set, or CORS_ORIGIN allows a production origin (packages/service-kit/src/deploy-env.ts).

DEPLOY_ENV=staging
NODE_ENV=production

# Network: testnet, all three agreeing (the services cross-check them at boot).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org

# Its OWN Postgres: add a SEPARATE Postgres service to the staging environment and
# reference ITS variable. Never reference the production environment's database.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Origins that may call the staging API. Never vellar.xyz / www / app.
CORS_ORIGIN=https://staging.vellar.xyz

# OpenZeppelin testnet relayer (testnet path suffix; the mainnet host has none).
RELAYER_BASE_URL=https://channels.openzeppelin.com/testnet

# Secrets: set in the dashboard, NEVER commit. TESTNET-ONLY keys, generated for
# staging and funded from friendbot. Do not reuse any production key.
# RELAYER_API_KEY=
# SPONSOR_SECRET_KEY=
# SPONSOR_PUBLIC_KEY=

# Must stay UNSET on staging (the boot policy rejects them):
#   ALLOW_INMEMORY
#   ALLOW_SINGLE_KEY_ATTESTOR
# The staging database must be a NEW, EMPTY Postgres. On its first boot set
# INIT_DEPLOY_MARKER=1 ONCE so the services claim it as staging (a one-row marker table),
# then unset it. A staging process refuses to boot against a database not marked staging,
# and a production process refuses a database marked staging. Never put production database
# credentials in the staging environment.
# INIT_DEPLOY_MARKER=1
