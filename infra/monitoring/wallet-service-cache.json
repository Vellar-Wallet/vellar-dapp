{
  "dashboard": {
    "title": "Wallet Service Cache Metrics",
    "description": "Cache hit/miss ratios and performance metrics for wallet-service resource caches",
    "tags": ["wallet-service", "cache", "observability"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Cache Hit Ratio (by Resource)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(wallet_service_cache_hits_total[5m])) by (resource) / (sum(rate(wallet_service_cache_hits_total[5m])) by (resource) + sum(rate(wallet_service_cache_misses_total[5m])) by (resource))",
            "legendFormat": "{{ resource }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 0
            },
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        },
        "options": {
          "legend": {
            "calcs": ["last", "mean"],
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 2,
        "title": "Cache Hits (5m Rate)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(wallet_service_cache_hits_total[5m])",
            "legendFormat": "{{ resource }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 0
            },
            "unit": "reqps"
          }
        },
        "options": {
          "legend": {
            "calcs": ["last", "mean"],
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 3,
        "title": "Cache Misses (5m Rate)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(wallet_service_cache_misses_total[5m])",
            "legendFormat": "{{ resource }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 0
            },
            "unit": "reqps"
          }
        },
        "options": {
          "legend": {
            "calcs": ["last", "mean"],
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 4,
        "title": "Cache Hit Ratio (by Resource, Gauge)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(wallet_service_cache_hits_total[5m])) by (resource) / (sum(rate(wallet_service_cache_hits_total[5m])) by (resource) + sum(rate(wallet_service_cache_misses_total[5m])) by (resource))",
            "legendFormat": "{{ resource }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "green",
                  "value": 0.8
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "title": "Cumulative Cache Hits",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(wallet_service_cache_hits_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "fixed",
              "fixedColor": "green"
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Cumulative Cache Misses",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(wallet_service_cache_misses_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "fixed",
              "fixedColor": "red"
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Cache Operations per Resource (Last 5m)",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "increase(wallet_service_cache_hits_total[5m])",
            "format": "table",
            "instant": true,
            "legendFormat": "Hits - {{ resource }}",
            "refId": "A"
          },
          {
            "expr": "increase(wallet_service_cache_misses_total[5m])",
            "format": "table",
            "instant": true,
            "legendFormat": "Misses - {{ resource }}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "showHeader": true
        }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "style": "dark",
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
